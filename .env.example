# Copiar este archivo como .env.local y completar. .env.local NO se sube a GitHub.
# En Vercel, las mismas variables se cargan en Settings → Environment Variables.

# Base de datos (Supabase → Connect → "Transaction pooler", puerto 6543).
# Sin esta variable, en local se usa una base de prueba en .data/ y en producción
# /reservar muestra los links a AgendaPro y WhatsApp.
DATABASE_URL=

# Mails (https://resend.com). Sin clave, en local los mails se guardan en .data/outbox.
RESEND_API_KEY=
# Remitente: tiene que ser de un dominio verificado en Resend.
EMAIL_FROM="Frank Barber <turnos@tudominio.com.ar>"
# Opcional: casilla de la barbería que recibe un aviso por cada turno nuevo o cancelado.
BOOKING_NOTIFY_EMAIL=

# Con 1, los botones "Reservar turno" llevan a /reservar en vez de a AgendaPro.
NEXT_PUBLIC_ONLINE_BOOKING=

# Opcional: forzar la URL pública del sitio (por defecto, la de Vercel).
NEXT_PUBLIC_SITE_URL=
